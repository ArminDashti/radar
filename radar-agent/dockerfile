# syntax=docker/dockerfile:1
# Build from repo root: docker build -f dockerfile -t radar-agent:latest .

FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -o /out/radar-agent ./cmd/radar-agent

FROM alpine:3.20
# iputils provides /bin/ping (same tool users run: ping 1.1.1.1)
RUN apk add --no-cache ca-certificates tzdata iputils
WORKDIR /app
COPY --from=build /out/radar-agent /app/radar-agent
CMD ["/app/radar-agent"]
